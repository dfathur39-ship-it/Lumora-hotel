PORT=3000
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173

# Supabase Storage — used for uploaded images (hotel/room photos).
# Required especially when deploying to a serverless host like Vercel,
# where the local disk is not persistent.
# 1. Supabase dashboard -> Storage -> New bucket -> name it, toggle "Public bucket"
# 2. Supabase dashboard -> Project Settings -> API -> copy the "service_role" key
#    (NOT the "anon" key — the service role key is required to bypass RLS on upload)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=lumora-uploads

# PayPal (get free sandbox credentials at https://developer.paypal.com/dashboard/applications)
# Leave blank to disable the PayPal payment method — the app still boots fine without it.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_RETURN_URL=http://localhost:5173/payment/paypal/return
PAYPAL_CANCEL_URL=http://localhost:5173/payment/paypal/cancel

# QRIS and Card/BCA use in-process SANDBOX providers (see
# backend/services/payment/qris.go and card.go) — they need no credentials
# because they don't talk to a real aggregator. Replace them with a real
# provider (e.g. Midtrans, Xendit) before accepting real payments; that
# provider's API key/secret would go here, e.g.:
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
